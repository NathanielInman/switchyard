#!/usr/bin/env bash
# Pretends to be a build tool for the Switchyard demo.
#   fake-build <seconds> [ok|fail-ts|fail-rust|crash]
secs="${1:-3}"; mode="${2:-ok}"
echo "  Resolving dependencies..."
echo "  Dependencies are up to date."
steps=$(( secs * 4 ))
for ((i = 1; i <= steps; i++)); do
  sleep 0.25
  (( i % 4 == 0 )) && echo "  Compiling unit $i of $steps"
done
case "$mode" in
  fail-ts)
    echo "src/billing/invoice.ts(212,17): error TS2339: Property 'minimumCharge' does not exist on type 'Plan'."
    echo ""
    echo "Found 1 error in src/billing/invoice.ts:212"
    exit 1 ;;
  fail-rust)
    echo "error[E0425]: cannot find value \`route\` in this scope"
    echo " --> src/router.rs:88:13"
    exit 101 ;;
  crash)
    echo "fatal: worker exited unexpectedly"
    kill -ABRT $$ ;;
esac
echo "Build succeeded."
